# ─────────────────────────────────────────────────────────────
# PrivateRAG AI Assistant — configuration
# Copyright (c) 2026 PrivateRAG. All rights reserved.
# Copy this file to `.env` and adjust as needed.
# Defaults match app/config.py. Nothing here is strictly required
# to run end-to-end (local embeddings + extractive fallback work).
# You pay your own cloud / API / token costs when using cloud LLMs.
# ─────────────────────────────────────────────────────────────

# ── Storage ──────────────────────────────────────────────────
# Where uploaded files and the FAISS index live.
DATA_DIR=data
# Reject uploads larger than this (bytes). Default 25 MB.
MAX_UPLOAD_BYTES=26214400

# ── Auth (admin / user roles) ────────────────────────────────
# When false (default), the UI needs no login and everyone acts as admin.
# Set true for deployed demos: admin can delete docs + edit config; users chat/upload.
AUTH_ENABLED=false
AUTH_SECRET=change-me-privaterag-secret
AUTH_TOKEN_TTL_SECONDS=86400
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
USER_USERNAME=user
USER_PASSWORD=user

# ── Embeddings ───────────────────────────────────────────────
# Provider: "local" (sentence-transformers, free, private) or "openai".
EMBEDDING_PROVIDER=local
# Local model (Hugging Face via sentence-transformers). 384-dim, strong retrieval.
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# OpenAI embedding model (used only when EMBEDDING_PROVIDER=openai).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Chunking ─────────────────────────────────────────────────
CHUNK_SIZE=800            # target characters per chunk
CHUNK_OVERLAP=120         # overlap characters between chunks

# ── OCR (scanned / image-only PDFs) ──────────────────────────
# When a page has little native text, rasterize it and run Tesseract.
# Docker image includes tesseract-ocr.
# Local: brew install tesseract  (macOS)
#        apt install tesseract-ocr  (Debian/Ubuntu)
#        https://github.com/UB-Mannheim/tesseract/wiki  (Windows)
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=200
OCR_MIN_CHARS_PER_PAGE=40

# ── Retrieval ────────────────────────────────────────────────
TOP_K=5                   # chunks sent to the LLM after rerank / MMR
MIN_SCORE=0.20            # cosine score below this => dropped before hybrid fuse
RERANK_ENABLED=true       # cross-encoder rerank after candidate fusion
RETRIEVE_K=40             # dense FAISS candidate pool size when reranking / hybrid on
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Hybrid retrieval (dense + BM25) ──────────────────────────
# BM25 lifts rare exact tokens (API names, error codes) into the pool;
# Reciprocal Rank Fusion merges dense + sparse rankings before rerank.
HYBRID_ENABLED=true
BM25_TOP_K=40
RRF_K=60
# Soft-demote chapter intros / TOC / wrap-ups so how-to pages can rank.
OVERVIEW_DEMOTE_ENABLED=true
OVERVIEW_DEMOTE_STRENGTH=0.55

# ── Query rewriting (multi-query retrieval) ──────────────────
# Expand the query into variants, retrieve for each, fuse pools (max-cosine).
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_NUM_VARIANTS=3   # extra variants beyond the original query
QUERY_REWRITE_USE_LLM=true     # use the LLM for paraphrases when available;
                               # falls back to a heuristic rewriter otherwise

# ── Diversity-aware reranking (MMR) ──────────────────────────
# Trims near-duplicate chunks while preserving relevance.
MMR_ENABLED=true
MMR_LAMBDA=0.55                # 1.0 = pure relevance, 0.0 = pure diversity
MMR_DEDUP_THRESHOLD=0.80       # hard cap: drop chunks with cosine >= this to a kept chunk
TEXT_DEDUPE_ENABLED=true       # word-overlap text filter after MMR
TEXT_DEDUPE_JACCARD=0.85       # 1.0 = exact normalized text only

# ── Context grouping ─────────────────────────────────────────
# Present chunks grouped by source in reading order, de-duplicating overlap.
CONTEXT_GROUPING_ENABLED=true

# ── Retrieval confidence gate ────────────────────────────────
# Refuse deterministically (no LLM call) when the best retrieved chunk scores
# below the threshold. Threshold applies to the post-rerank score: cross-encoder
# logits (relevant >~ 0) when rerank is on, or cosine when it is off.
RETRIEVAL_GATE_ENABLED=true
RETRIEVAL_GATE_MIN_SCORE=0.0

# ── Answer validation gate ───────────────────────────────────
# After generation, check that [n] citations exist and are supported by their
# cited chunk. Failing answers get a disclaimer and grounded=false.
ANSWER_VALIDATION_ENABLED=true
ANSWER_VALIDATION_MIN_SUPPORT=0.5   # min fraction of citations that must be supported

# ── Prompt injection defense ─────────────────────────────────
# Quarantine user/document text; harden system prompt. When BLOCK=true, common
# jailbreak phrases refuse before the LLM is called.
PROMPT_INJECTION_ENABLED=true
PROMPT_INJECTION_BLOCK=true

# ── Chat memory (multi-turn history) ─────────────────────────
# Send conversation_id on /chat to continue a thread. Storage is in-process.
CHAT_MEMORY_ENABLED=true
CHAT_MEMORY_MAX_TURNS=10            # max stored messages (user + assistant)
CHAT_MEMORY_CONTEXTUALIZE=true      # rewrite follow-ups for better retrieval
CHAT_MEMORY_CONTEXTUALIZE_USE_LLM=true

# ── LLM Router ───────────────────────────────────────────────
# Provider: "auto" | "openai" | "gemini" | "ollama" | "extractive"
#   auto       -> prefers LLM_PROVIDER when set to a concrete provider with
#                 credentials; else openai → gemini → ollama → extractive
#   openai     -> force OpenAI cloud (accuracy mode)
#   gemini     -> force Google Gemini cloud
#   ollama     -> force local (privacy mode)
#   extractive -> no LLM; answer is stitched from retrieved chunks
LLM_PROVIDER=auto

# OpenAI (cloud / accuracy mode) — keys start with sk-
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Google Gemini (cloud). Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Ollama (local / privacy mode). Install: https://ollama.com
# Model tiers (pick one that fits your RAM alongside embeddings + reranker):
#   8 GB  (M1/M2)  -> qwen2.5:3b   (recommended default)
#   16 GB          -> qwen2.5:7b or llama3.1:8b
#   32 GB+         -> qwen2.5:14b
# Pull: ollama pull qwen2.5:3b
# Docker on Mac/Windows: host.docker.internal (set in docker-compose.yml)
# Docker on Linux: compose adds host-gateway; or set OLLAMA_BASE_URL to your host IP
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=3000
