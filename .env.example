# ─────────────────────────────────────────────────────────────
# PrivateRAG AI Assistant — configuration
# Copy this file to `.env` and adjust as needed.
# Everything has a sensible default; nothing here is strictly
# required to run the system end-to-end.
# ─────────────────────────────────────────────────────────────

# ── Storage ──────────────────────────────────────────────────
# Where uploaded files and the FAISS index live.
DATA_DIR=data
# Reject uploads larger than this (bytes). Default 25 MB.
MAX_UPLOAD_BYTES=26214400

# ── Embeddings ───────────────────────────────────────────────
# Provider: "local" (sentence-transformers, free, private) or "openai".
EMBEDDING_PROVIDER=local
# Local model (Hugging Face via sentence-transformers). 384-dim, strong retrieval.
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# OpenAI embedding model (used only when EMBEDDING_PROVIDER=openai).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Chunking ─────────────────────────────────────────────────
CHUNK_SIZE=500            # target characters per chunk
CHUNK_OVERLAP=120         # overlap characters between chunks

# ── Retrieval ────────────────────────────────────────────────
TOP_K=3                   # number of chunks sent to the LLM after reranking
MIN_SCORE=0.20            # cosine score below this => dropped before rerank
RERANK_ENABLED=true       # cross-encoder rerank after FAISS search
RETRIEVE_K=20             # FAISS candidate pool size when reranking is on
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Query rewriting (multi-query retrieval) ──────────────────
# Expand the query into variants, retrieve for each, fuse pools (max-cosine).
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_NUM_VARIANTS=3   # extra variants beyond the original query
QUERY_REWRITE_USE_LLM=true     # use the LLM for paraphrases when available;
                               # falls back to a heuristic rewriter otherwise

# ── Diversity-aware reranking (MMR) ──────────────────────────
# Trims near-duplicate chunks while preserving relevance.
MMR_ENABLED=true
MMR_LAMBDA=0.6                 # 1.0 = pure relevance, 0.0 = pure diversity (tuned)
MMR_DEDUP_THRESHOLD=0.85       # hard cap: drop chunks with cosine >= this to a kept chunk
                               # (required — soft MMR alone keeps near-duplicates)
TEXT_DEDUPE_ENABLED=true       # word-overlap text filter after MMR
TEXT_DEDUPE_JACCARD=0.85       # 1.0 = exact normalized text only

# ── Context grouping ─────────────────────────────────────────
# Present chunks grouped by source in reading order, de-duplicating overlap.
CONTEXT_GROUPING_ENABLED=true

# ── Retrieval confidence gate ────────────────────────────────
# Refuse deterministically (no LLM call) when the best retrieved chunk scores
# below the threshold. Threshold applies to the post-rerank score: cross-encoder
# logits (relevant >~ 0) when rerank is on, or cosine when it is off.
RETRIEVAL_GATE_ENABLED=true
RETRIEVAL_GATE_MIN_SCORE=0.0

# ── Answer validation gate ───────────────────────────────────
# After generation, check that [n] citations exist and are supported by their
# cited chunk. Failing answers get a disclaimer and grounded=false.
ANSWER_VALIDATION_ENABLED=true
ANSWER_VALIDATION_MIN_SUPPORT=0.5   # min fraction of citations that must be supported

# ── Prompt injection defense ─────────────────────────────────
# Quarantine user/document text; harden system prompt. When BLOCK=true, common
# jailbreak phrases refuse before the LLM is called.
PROMPT_INJECTION_ENABLED=true
PROMPT_INJECTION_BLOCK=true

# ── Chat memory (multi-turn history) ─────────────────────────
# Send conversation_id on /chat to continue a thread. Storage is in-process.
CHAT_MEMORY_ENABLED=true
CHAT_MEMORY_MAX_TURNS=10            # max stored messages (user + assistant)
CHAT_MEMORY_CONTEXTUALIZE=true      # rewrite follow-ups for better retrieval
CHAT_MEMORY_CONTEXTUALIZE_USE_LLM=true

# ── LLM Router ───────────────────────────────────────────────
# Provider: "auto" | "openai" | "gemini" | "ollama" | "extractive"
#   auto       -> openai if key present, else gemini if key present,
#                 else ollama if reachable, else extractive
#   openai     -> force OpenAI cloud (accuracy mode)
#   gemini     -> force Google Gemini cloud
#   ollama     -> force local (privacy mode)
#   extractive -> no LLM; answer is stitched from retrieved chunks
LLM_PROVIDER=auto

# OpenAI (cloud / accuracy mode)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Google Gemini (cloud). Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Ollama (local / privacy mode). Install: https://ollama.com
# Model tiers (pick one that fits your RAM alongside embeddings + reranker):
#   8 GB  (M1/M2)  -> qwen2.5:3b   (recommended default)
#   16 GB          -> qwen2.5:7b or llama3.1:8b
#   32 GB+         -> qwen2.5:14b
# Pull: ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=180
